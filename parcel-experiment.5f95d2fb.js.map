const date = "2026-02-19 20:10:00";
function formatDetailedTime(date, maxUnits = 3) {
    const now = new Date();
    const target = new Date(date);
    // 计算总时间差（毫秒）
    let diff = now - target;
    // 如果时间是未来，取绝对值
    const isFuture = diff < 0;
    diff = Math.abs(diff);
    // 计算各个时间单位
    const seconds = Math.floor(diff / 1000);
    const minutes = Math.floor(seconds / 60);
    const hours = Math.floor(minutes / 60);
    const days = Math.floor(hours / 24);
    const months = Math.floor(days / 30.44); // 平均每月30.44天
    const years = Math.floor(months / 12);
    // 计算剩余部分（取余数）
    const remainingMonths = months % 12;
    const remainingDays = days % 30.44;
    const remainingHours = hours % 24;
    const remainingMinutes = minutes % 60;
    const remainingSeconds = seconds % 60;
    // 构建显示文本
    const parts = [];
    if (years > 0) parts.push(`${years}\u{5E74}`);
    if (remainingMonths > 0) parts.push(`${remainingMonths}\u{4E2A}\u{6708}`);
    if (remainingDays > 0) parts.push(`${Math.floor(remainingDays)}\u{5929}`);
    if (remainingHours > 0) parts.push(`${remainingHours}\u{5C0F}\u{65F6}`);
    if (remainingMinutes > 0) parts.push(`${remainingMinutes}\u{5206}\u{949F}`);
    if (remainingSeconds > 0) parts.push(`${remainingSeconds}\u{79D2}`);
    // 如果所有单位都是0，说明是刚刚
    if (parts.length === 0) return "\u521A\u521A";
    const suffix = isFuture ? "\u540E" : "\u524D";
    //return `${parts.join('')}${suffix}`;
    // 只显示前 maxUnits 个
    return parts.slice(0, maxUnits).join('');
}
// 使用示例
//const date = '2024-01-15T10:30:00';
//document.body.textContent = formatDetailedTime(date);
// 输出类似：1年7月14天3小时25分钟30秒前
// 等 DOM 加载完成后更新容器
document.addEventListener('DOMContentLoaded', ()=>{
    const display = document.getElementById('time-display');
    if (display) display.textContent = `\u{1F4C5} ${formatDetailedTime(date)}`;
});

